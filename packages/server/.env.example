# Backend + Prisma configuration.
# Copy to packages/server/.env (npm run setup:env does this for you).
#
# This file is committed. packages/server/.env is gitignored. Never put a real
# API key in this file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection used by the API and by the Prisma CLI.
DATABASE_URL=postgresql://pursuit:pursuit@localhost:55432/pursuit?schema=public

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Model provider ---------------------------------------------------------
# Which ModelProvider implementation to resolve.
#   none - no model. The API keeps working; ICP analysis reports the provider
#          as unavailable.
#   groq - an open-weight model on Groq's hosted API.
#
# There is no local-inference option: the analysis runs against a hosted API,
# and a Groq failure is reported as a model error rather than falling back.
MODEL_PROVIDER=groq

# Groq credential. Create one at https://console.groq.com/keys
#
# Backend only. It is never sent to the frontend, stored in PostgreSQL or
# written to a log, and it must never be given a VITE_ prefix.
GROQ_API_KEY=your_groq_api_key_here

# The concrete open-weight model. Configuration, never hardcoded in business
# logic: GROQ_MODEL=<anything Groq serves> selects a different one.
#
# 120b, not the 20b this started on. Groq validates a structured answer after
# generating it rather than constraining the decoder, so a model is free to emit
# malformed JSON - and against the twelve-section analysis contract, gpt-oss-20b
# did on half its runs, closing a nested array with } instead of ]. gpt-oss-120b
# returned fourteen consecutive complete, Zod-valid analyses on the same prompt,
# for about 600 more completion tokens and a few seconds each.
GROQ_MODEL=openai/gpt-oss-120b

# How much reasoning the model may spend before answering.
#
# Load-bearing, not a tweak: left at the model's own default, a gpt-oss model
# spends its completion budget thinking and then closes the analysis JSON early,
# dropping the last sections and failing the contract on most runs.
#
# Accepted values are model-specific (gpt-oss: low|medium|high, qwen3:
# none|default). Leave empty to omit the parameter for a model that rejects it.
GROQ_REASONING_EFFORT=low

# Groq's OpenAI-compatible base URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Wall-clock budget for one analysis. A gpt-oss analysis on Groq answers in
# seconds, so two minutes is headroom for a slow network or a queued request -
# not an expected duration. It is also what stops a hung socket from becoming a
# request that never returns.
MODEL_TIMEOUT_MS=120000

# Completion budget for one analysis, in tokens.
#
# The icp-analysis.v2 contract is twelve sections of reasoned prose, so it needs
# thousands of tokens of room where the old signal lists needed hundreds.
# Reasoning tokens come out of the same budget, and running out mid-object is
# reported by Groq as a schema violation rather than as a truncation - so the
# cap is set explicitly instead of left to the provider default.
MODEL_MAX_OUTPUT_TOKENS=8192

# How many times one analysis may be attempted, in total.
#
# The retry covers exactly one class of failure: the model answered, and the
# answer missed the output contract - a top-level array instead of an object, a
# required key dropped, a list left short. Groq validates after generating, so
# these arrive as a 400 on work that was otherwise fine, and asking again with
# the breach named usually lands. Nothing else is retried: a rate limit or a
# timeout is not improved by asking twice.
#
# It is a second attempt, not a repair - the analysis is regenerated from the
# briefing and no part of the rejected answer survives.
#
# Defaults to 1 - off - because of measured token limits, not doubt about the
# mechanism. One analysis costs roughly 5.3k tokens and the free tier allows 8k
# per minute, so a second call issued immediately cannot fit: it would 429
# rather than succeed, while still spending against a 200k daily ceiling that
# affords only about 37 analyses.
#
# Raise it to 2 on any account with per-minute headroom. That is where it pays.
MODEL_MAX_ATTEMPTS=1

# Stamped onto every stored analysis, so a result can be traced to the prompt
# that produced it. Bump it whenever the prompt text changes.
#
# v3 rewrote the task from "restate the ICP as signals" to "turn the ICP into
# discovery intelligence".
MODEL_PROMPT_VERSION=v3

# --- Prospect discovery -----------------------------------------------------
# Which data provider to resolve, for BOTH company discovery and people search.
#   none   - no data provider. The API keeps working; a discovery or prospect
#            attempt reports the provider as unavailable.
#   apollo - Apollo's organization search and people search APIs.
#
# One setting covers both because it names the vendor, not one of its
# endpoints. There is no fallback between providers: an Apollo failure is
# reported as an Apollo failure rather than silently answered by something else.
#
# Set this to apollo to enable the "Find matching leads" step in the UI.
DISCOVERY_PROVIDER=none

# Apollo credential. Create one at https://app.apollo.io/#/settings/integrations/api
#
# Backend only. It is never sent to the frontend, stored in PostgreSQL or
# written to a log, and it must never be given a VITE_ prefix.
#
# The key also needs its *scope* to include the endpoints used here:
#   POST /api/v1/mixed_companies/search    (organization search)
#   POST /api/v1/mixed_people/api_search   (people search, used by prospects)
#   GET  /api/v1/auth/health               (the credential probe)
# A key without them authenticates but returns HTTP 403 API_INACCESSIBLE, which
# the API reports as a named credential problem rather than as an outage. The
# two search scopes are granted separately in the Apollo console, so a key can
# authenticate and serve companies while refusing people.
APOLLO_API_KEY=your_apollo_api_key_here

# Apollo's API root. The adapter appends /api/v1/... itself.
APOLLO_BASE_URL=https://api.apollo.io

# Wall-clock budget for one Apollo HTTP request. Organization search answers in
# well under a second, so ten seconds is headroom for a slow network - and the
# only thing standing between a hung socket and a request that never returns.
# A search walks several pages, so a generous per-request budget multiplies.
APOLLO_TIMEOUT_MS=10000

# How many times one Apollo request may be attempted, in total.
#
# The retry covers only failures where the call did not happen: a network error,
# or a 408/5xx. A dropped socket is usually not dropped twice. Nothing else is
# retried - a 429 in particular is never retried, because the window is
# exhausted and asking again inside it makes the rate limit worse.
APOLLO_MAX_ATTEMPTS=2

# First backoff step between Apollo attempts; doubled per attempt.
APOLLO_RETRY_BASE_DELAY_MS=250

# Hard ceiling on Apollo pages per discovery search.
#
# Apollo bills a credit per page, so this is a spend control rather than a
# performance one, and it is independent of the caller's `limit` so a bad
# request cannot walk Apollo's full 500-page range.
APOLLO_MAX_PAGES_PER_SEARCH=5

# --- Contact enrichment -----------------------------------------------------

# Whether to enrich surviving candidates with contact details.
#
# On by default, because without it a prospect search cannot answer the question
# it exists for: Apollo's people *search* returns neither email addresses nor
# phone numbers - those come only from the separate enrichment endpoints - so a
# run with enrichment off produces a list of names nobody can contact.
#
# Turn it off for an account whose plan excludes enrichment (so calls that can
# only fail are never made), or for an account-mapping exercise that wants
# companies rather than contacts. The pipeline then runs exactly as before and
# the response carries no enrichment block.
APOLLO_ENRICHMENT_ENABLED=true

# Whether to ask Apollo to reveal phone numbers during enrichment.
#
# Off by default, and deliberately the one thing you have to opt into. Phone
# reveal consumes a separate Apollo credit type from email enrichment, and
# Apollo resolves it *asynchronously* - so the numbers are frequently not in the
# response that requested them, and the credit is spent either way.
#
# This application has no public HTTPS webhook receiver, so the request is
# always sent poll-only: whatever Apollo has ready comes back, anything still
# running is reported as PENDING on that prospect, and a later run picks it up.
APOLLO_REVEAL_PHONE_NUMBERS=false

# Hard ceiling on candidates enriched per search run.
#
# A spend control, independent of the caller's page size, so a large page cannot
# quietly become a large bill - the same role APOLLO_MAX_PAGES_PER_SEARCH plays
# for search. Survivors beyond it are reported as NOT_REQUESTED rather than
# silently ignored.
APOLLO_MAX_ENRICHMENTS_PER_RUN=25
